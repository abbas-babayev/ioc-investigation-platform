# .gitignore — файлы, которые НЕ должны попадать в GitHub

# === БЕЗОПАСНОСТЬ — САМОЕ ВАЖНОЕ ===
# .env содержит API ключи — НИКОГДА не пушь его!
.env
*.env
!.env.example       # .env.example пушим — это шаблон без реальных данных

# === Python ===
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.pyc

# === Virtual environments ===
venv/
env/
ENV/
.venv/

# === IDE / редакторы ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store       # macOS

# === Logs ===
*.log
logs/

# === Docker ===
docker-compose.override.yml
